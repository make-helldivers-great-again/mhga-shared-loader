{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "9471bcb16f3a479efdff3e0520def4573ae0a028",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "FORK-CHANGELOG.md",
